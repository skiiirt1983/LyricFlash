CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Screen-off CPU DFS, no automatic light sleep.
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=n
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y

# ESP-IDF 5.5.4: rollback requires a rollback-enabled bootloader.
# This default does NOT alter the bootloader already installed by PrintSphere via app-only OTA.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# Verify Open-Meteo HTTPS with standard trusted roots.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_32=y

# CO5300 AMOLED SPI stability baseline from tested hardware configuration.
# The BSP default queues ten transactions; limit outstanding DMA to one.
CONFIG_BSP_LCD_TRANS_QUEUE_DEPTH=1
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPI_MASTER_IN_IRAM=y
CONFIG_LV_DEF_REFR_PERIOD=16
# LVGL 9.5 style lookups on complex static page trees; add only 8 bytes/object.
# CONFIG_LV_OBJ_STYLE_CACHE is not set

# 0.8.105 performance profile
# Build with -O2 instead of the default -Og debug optimization (LVGL software
# rendering is several times faster).
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# Largest ESP32-S3 caches: fewer stalls reading fonts (flash) and PSRAM.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_8WAYS=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# TLS buffers in PSRAM: GitHub OTA download failed with SSL_ALLOC_FAILED
# (-0x7F00) when internal RAM was exhausted.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Single LVGL draw unit (two units are unproven; a UI-stall watchdog restart was logged).
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
# Temporary on-screen FPS / CPU meter for hardware tuning.
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_LV_PERF_MONITOR_ALIGN_BOTTOM_MID=y
# 0.8.105: smaller peak TLS memory for the on-device GitHub OTA download.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
